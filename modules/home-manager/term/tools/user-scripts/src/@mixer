#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./homelab_library.sh
. "$script_dir/homelab_library.sh"

# Vars
volvalue=5
timeout=3000
notify_id=990000
max_volume=150

usage() {
    echo "Usage: @mixer {output|mic} {up|down|mute}" >&2
    exit 1
}

get_target() {
    case "$1" in
    output)
        printf '%s\n' "@DEFAULT_AUDIO_SINK@"
        ;;
    mic)
        printf '%s\n' "@DEFAULT_AUDIO_SOURCE@"
        ;;
    *)
        usage
        ;;
    esac
}

get_state() {
    wpctl get-volume "$1" 2>/dev/null | awk '
        {
            volume = int(($2 * 100) + 0.5)
            muted = ($3 == "[MUTED]") ? 1 : 0
            printf "%s %s\n", volume, muted
        }
    '
}

# Send notification
function notify {
    read -r volume muted <<<"$(get_state "$1")"

    # Search font symbol => https://www.nerdfonts.com/cheat-sheet
    if [ "$muted" -ne 1 ]; then
        if [ "$volume" -lt 34 ]; then
            icon="󰕿"
        elif [ "$volume" -lt 67 ]; then
            icon="󰖀"
        elif [ "$volume" -le 100 ]; then
            icon="󰕾"
        else
            icon="󱄡"
        fi
        dunstify -u low -r "$notify_id" -t "$timeout" -h "int:value:$volume" "$icon  $volume%"
    else
        dunstify -u low -r "$notify_id" -t "$timeout" "󰝟 muted"
    fi
}

# Update volume
mix() {
    read -r current_volume current_muted <<<"$(get_state "$2")"
    local rounded_volume
    local target_volume

    case $1 in
    up)
        rounded_volume=$(round_to_nearest_step "$current_volume" "$volvalue")
        target_volume=$(clamp $((rounded_volume + volvalue)) 0 "$max_volume")
        wpctl set-mute "$2" 0 2>/dev/null
        wpctl set-volume "$2" "${target_volume}%" 2>/dev/null
        ;;
    down)
        rounded_volume=$(round_to_nearest_step "$current_volume" "$volvalue")
        target_volume=$(clamp $((rounded_volume - volvalue)) 0 "$max_volume")
        wpctl set-mute "$2" 0 2>/dev/null
        wpctl set-volume "$2" "${target_volume}%" 2>/dev/null
        ;;
    mute)
        wpctl set-mute "$2" toggle 2>/dev/null
        ;;
    *)
        usage
        ;;
    esac

    notify "$2"
}

# Select source
case "${1:-}" in
output)
    mix "${2:-}" "$(get_target "$1")"
    ;;
mic)
    mix "${2:-}" "$(get_target "$1")"
    ;;
*)
    usage
    ;;
esac
